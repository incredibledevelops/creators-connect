# ============================================================
#  Creators Connect — backend environment
#  EVERY value below is REQUIRED unless marked (optional).
#  The app refuses to start if a required key is missing.
# ============================================================

# ---------- App ----------
ENVIRONMENT=development
APP_NAME=Creators Connect
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- MongoDB ----------
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=creators_connect

# ---------- JWT ----------
JWT_SECRET_KEY=replace-with-a-64-char-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------- OAuth state signing ----------
OAUTH_STATE_EXPIRE_MINUTES=10

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/drive/oauth/callback

# ---------- Drive token encryption ----------
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key

# ---------- Paystack ----------
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CURRENCY=GHS

# ---------- Storage ----------
STORAGE_DIR=storage
MAX_AVATAR_BYTES=2097152
MAX_CHAT_FILE_BYTES=52428800
MAX_DRIVE_UPLOAD_BYTES=524288000

# ---------- Subscription ----------
TRIAL_DAYS=14
SUBSCRIPTION_PERIOD_DAYS=30

# ---------- Email (SMTP) ----------
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@creatorsconnect.local
SMTP_FROM_NAME=Creators Connect
SMTP_USE_TLS=true

# ---------- Rate limits ----------
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_PAYMENT=5/minute
RATE_LIMIT_DEFAULT=120/minute

# ---------- Housekeeping ----------
ORPHAN_UPLOAD_MAX_AGE_DAYS=30